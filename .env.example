# Port for the Node server (Docker / VPS). Vercel ignores this.
PORT=5000
# SQLite file for the Node server. Use ":memory:" for throwaway runs.
DATABASE_PATH=./data/data.db
# Storage override: sqlite | redis | memory (auto-detected when unset)
# STORAGE=sqlite
# Upstash Redis (Vercel Marketplace "Upstash for Redis" sets these automatically)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
APP_VERSION=1.0.0
